<Window x:Class="BotClientDriverHostUi.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务端要求输入密码"
        Height="230" Width="480"
        Background="#FF1E1E1E" Foreground="#FFDDDDDD"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="服务端弹出了密码框（!Setup.txt 的仓库/动作保护）。不输入的话，角色无法行走 / 攻击 / 用药 —— 服务端会把所有这些动作整包丢弃，而且不给任何错误回包。" />

    <TextBlock Grid.Row="1" Text="密码（不落盘，用完即弃）" Margin="0,0,0,4" Foreground="#FF9AA0A6" />

    <PasswordBox x:Name="PwBox" Grid.Row="2" Height="26"
                 Background="#FF2A2A2A" Foreground="#FFDDDDDD" BorderBrush="#FF3C3C3C" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="确定" Width="84" Height="28" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
      <Button Content="取消" Width="84" Height="28" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
