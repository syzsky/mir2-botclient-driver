<Window x:Class="BotClientDriverHostUi.Views.ClientPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择客户端（扫描全部传奇客户端 · 各引擎通用）"
        Width="1180" Height="500" MinWidth="820" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontSize="13">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
               Text="列出本机所有持有外部 TCP 连接的客户端进程（各引擎/各客户端都算，已过滤浏览器等无关进程）。&#10;同名多开时逐条列出各自的连接，选中哪一条就跟随哪一条：选定后把该行钉住 —— PID + 窗口句柄同时写回 clientdriver.json。&#10;句柄绑定优先：改分辨率、改窗口标题、切全屏都仍然指向同一个窗口（多开也天然分得清）；进程重启后 PID 与句柄一起失效，自动退回按进程名匹配。" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
      <Button x:Name="RescanBtn" Content="重新扫描" Style="{StaticResource PrimaryButton}" Click="OnRescanClick" />
      <Button x:Name="AutoFrameBtn" Content="自动探测定界（15 秒·只读）" Click="OnAutoFrameClick" />
      <Button x:Name="UnpinBtn" Content="取消 PID/句柄锁定" Click="OnUnpinClick" />
      <CheckBox x:Name="GameOnlyChk" Content="只看疑似游戏客户端" VerticalAlignment="Center" Margin="12,0,0,0"
                Foreground="{StaticResource Text}" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="10,0,0,0"
                 Foreground="{StaticResource TextDim}" Text="—" />
    </StackPanel>

    <ListView x:Name="CandidateList" Grid.Row="2" FontFamily="Consolas" FontSize="12"
              Background="#FF121212"
              MouseDoubleClick="OnRowDoubleClick">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding Kind}" />
          <GridViewColumn Header="进程名" Width="150" DisplayMemberBinding="{Binding ProcessName}" />
          <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Pid}" />
          <GridViewColumn Header="窗口句柄" Width="90" DisplayMemberBinding="{Binding HwndText}" />
          <GridViewColumn Header="窗口标题" Width="220" DisplayMemberBinding="{Binding WindowTitle}" />
          <GridViewColumn Header="窗口尺寸 / 占屏" Width="140" DisplayMemberBinding="{Binding WindowSize}" />
          <GridViewColumn Header="子控件" Width="65" DisplayMemberBinding="{Binding ChildCountText}" />
          <GridViewColumn Header="渲染模块" Width="100" DisplayMemberBinding="{Binding RenderModule}" />
          <GridViewColumn Header="窗口类" Width="120" DisplayMemberBinding="{Binding WindowClass}" />
          <GridViewColumn Header="父进程" Width="110" DisplayMemberBinding="{Binding ParentName}" />
          <GridViewColumn Header="服务端" Width="150" DisplayMemberBinding="{Binding ServerIp}" />
          <GridViewColumn Header="端口" Width="60" DisplayMemberBinding="{Binding ServerPort}" />
          <GridViewColumn Header="本地端口" Width="85" DisplayMemberBinding="{Binding LocalPort}" />
          <GridViewColumn Header="连接" Width="90" DisplayMemberBinding="{Binding PortKind}" />
          <GridViewColumn Header="评分" Width="60" DisplayMemberBinding="{Binding Score}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="{StaticResource TextDim}"
               Text="要选的是「类型=游戏」那一条：渲染窗特征（加载 ddraw/d3d9/opengl32、可缩放主窗、几乎无子控件、占屏过半）+ 非 HTTP 端口，往往父进程就是登录器。&#10;判据与分辨率无关 —— 全屏、1920×1080、800×600 窗口都能认出来（窗口尺寸列只是参考）。&#10;标成「疑似登录器」的行多为登录器/更新器的 HTTP 连接、或小工具窗，别选它。候选为空 = 客户端还没启动或还没点登录。" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="ApplyBtn" Content="选定并跟随" Style="{StaticResource PrimaryButton}" Click="OnApplyClick" />
      <Button Content="关闭" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
