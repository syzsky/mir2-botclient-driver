<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 深色主题：颜色取自 VS / 传奇暗色风格，尽量少用模板，避免与系统主题冲突 -->
  <SolidColorBrush x:Key="Bg" Color="#FF1E1E1E" />
  <SolidColorBrush x:Key="Panel" Color="#FF252526" />
  <SolidColorBrush x:Key="Panel2" Color="#FF2D2D30" />
  <SolidColorBrush x:Key="Line" Color="#FF3F3F46" />
  <SolidColorBrush x:Key="Text" Color="#FFDDDDDD" />
  <SolidColorBrush x:Key="TextDim" Color="#FF9A9A9A" />
  <SolidColorBrush x:Key="Accent" Color="#FF0E639C" />

  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Background" Value="#FF333337" />
    <Setter Property="Foreground" Value="#FFE6E6E6" />
    <Setter Property="BorderBrush" Value="#FF3F3F46" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF0E639C" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#FF6A6A6A" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Background" Value="#FF0E639C" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#FF1B1B1B" />
    <Setter Property="Foreground" Value="#FFE6E6E6" />
    <Setter Property="BorderBrush" Value="#FF3F3F46" />
    <Setter Property="CaretBrush" Value="#FFE6E6E6" />
    <Setter Property="Padding" Value="3,2" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#FFDDDDDD" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="#FFDDDDDD" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="#FF161616" />
    <Setter Property="Foreground" Value="#FFDDDDDD" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style TargetType="ListView">
    <Setter Property="Background" Value="#FF161616" />
    <Setter Property="Foreground" Value="#FFDDDDDD" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="#FFDDDDDD" />
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="#FFDDDDDD" />
    <Setter Property="Padding" Value="2,1" />
  </Style>

  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="#FF2D2D30" />
    <Setter Property="Foreground" Value="#FFDDDDDD" />
    <Setter Property="BorderBrush" Value="#FF3F3F46" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="#FF1E1E1E" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="#FFBFBFBF" />
    <Setter Property="Background" Value="#FF2D2D30" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#FF3F3F46"
                  BorderThickness="0,0,1,1" Padding="12,6">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF1E1E1E" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3F" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="#FF3F3F46" />
  </Style>

  <Style TargetType="Border" x:Key="ChipBorder">
    <Setter Property="Background" Value="#FF1B1B1B" />
    <Setter Property="BorderBrush" Value="#FF3F3F46" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

</ResourceDictionary>
